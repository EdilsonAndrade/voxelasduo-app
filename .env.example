# String de conexão do cluster MongoDB Atlas (tier gratuito M0).
# Nunca commitar o valor real — preencha em .env.local (dev) e nas
# variáveis de ambiente do projeto na Vercel (produção).
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=

# Token de leitura/escrita do Vercel Blob (fotos de produto).
# Gerado automaticamente ao conectar um Blob store ao projeto na Vercel;
# em desenvolvimento local, obtenha com `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# Credenciais do Mercado Pago (Tarefa 4 — integração de pagamento).
# Geradas em developers.mercadopago.com.br > Suas integrações > aplicação de teste.
# Public Key precisa do prefixo NEXT_PUBLIC_ para o SDK do Payment Brick rodar no navegador.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Gerado ao cadastrar a URL do webhook no painel do Mercado Pago; valida a assinatura (x-signature).
MERCADOPAGO_WEBHOOK_SECRET=