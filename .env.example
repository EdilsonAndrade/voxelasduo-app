# String de conexão do cluster MongoDB Atlas (tier gratuito M0).
# Nunca commitar o valor real — preencha em .env.local (dev) e nas
# variáveis de ambiente do projeto na Vercel (produção).
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=

# Token de leitura/escrita do Vercel Blob (fotos de produto).
# Gerado automaticamente ao conectar um Blob store ao projeto na Vercel;
# em desenvolvimento local, obtenha com `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# Credenciais do Mercado Pago (Tarefa 4 — integração de pagamento).
# Geradas em developers.mercadopago.com.br > Suas integrações > aplicação de teste.
# Public Key precisa do prefixo NEXT_PUBLIC_ para o SDK do Payment Brick rodar no navegador.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Gerado ao cadastrar a URL do webhook no painel do Mercado Pago; valida a assinatura (x-signature).
MERCADOPAGO_WEBHOOK_SECRET=

# Credenciais do Mercado Livre (Tarefa 5 — sincronização de estoque).
# Geradas em developers.mercadolivre.com.br > Suas aplicações.
# O par accessToken/refreshToken em uso fica persistido no MongoDB (coleção
# credenciaisCanais), não aqui — o refreshToken do ML é rotacionado a cada uso.
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
# URL cadastrada na aplicação do Mercado Livre para o redirect do OAuth2
# (ex: https://<seu-dominio>/api/estoque/mercado-livre/callback).
MERCADOLIVRE_REDIRECT_URI=

# Segredo para proteger POST /api/estoque/sincronizar (chamado pelo Vercel Cron).
CRON_SECRET=

# Segredo usado pelo NextAuth (Tarefa 9 — autenticação do painel administrativo)
# para assinar o cookie de sessão (JWT). Gerar com: openssl rand -base64 32
AUTH_SECRET=

# Credenciais do Google OAuth (Tarefa 10 — login social do cliente).
# Geradas em console.cloud.google.com > APIs & Serviços > Credenciais > OAuth Client ID.
# Redirect URI a cadastrar: https://<seu-dominio>/api/auth/cliente/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Segredo do NextAuth do cliente (Tarefa 10) — sessão separada da do admin.
# Gerar com: openssl rand -base64 32
AUTH_CLIENTE_SECRET=

# API key do Resend (Tarefa 10 — e-mails transacionais: recuperação de senha
# do cliente e notificação ao admin em venda de canal externo).
# Gerada em resend.com > API Keys, após verificar o domínio de envio.
RESEND_API_KEY=
# Endereço remetente verificado no Resend (ex: naoresponda@seudominio.com).
EMAIL_FROM=
# E-mail do administrador que recebe a notificação de venda sincronizada.
ADMIN_NOTIFICACAO_EMAIL=

# Credenciais da Shopee Open Platform (Tarefa 5 — pendente de aprovação do
# app na Shopee; enquanto vazias, o canal Shopee roda como "não configurado").
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=